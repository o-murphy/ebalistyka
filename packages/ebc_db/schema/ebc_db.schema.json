{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebc_db/schema/ebc_db.schema.json",
  "title": "eBalistyka Db",
  "description": "Canonical schema for the app's protobuf Db document (snake_case, as produced by DbValidator's hand-written proto→JSON conversion). Db is the whole in-memory app state, persisted to disk via DbFile/DbStore. See docs/backlogs/8.PROTOBUF_STORAGE_MIGRATION.md. Numeric ranges and defaults are ported from lib/core/models/field_constraints.dart (FC) in the main app, converted from FC's rawUnit into the unit each field is actually stored in here (documented per-field below) — FC itself is the single source of truth for these limits, not this file.",
  "$ref": "#/$defs/Db",
  "$defs": {
    "Weapon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "caliber_inch", "caliber_name", "twist_inch",
        "barrel_length_inch", "zero_elevation_rad", "vendor", "notes", "image"
      ],
      "properties": {
        "name": { "type": "string", "default": "" },
        "caliber_inch": {
          "description": "FC.projectileDiameter, mm→inch (1–30mm). optional in the .proto — null/absent means unset (DbValidator emits null via hasCaliberInch()).",
          "type": ["number", "null"],
          "minimum": 0.03937007874015748, "maximum": 1.1811023622047244,
          "default": null
        },
        "caliber_name": { "type": "string", "default": "" },
        "twist_inch": {
          "description": "FC.twist is [0,30] as an input-widget magnitude; storage is signed (direction encoded by sign, see weapon_wizard_notifier.dart).",
          "type": "number", "minimum": -30, "maximum": 30, "default": 0.0
        },
        "barrel_length_inch": {
          "description": "FC.barrelLength, inch (1–36). optional in the .proto — null/absent means unset.",
          "type": ["number", "null"],
          "minimum": 1.0, "maximum": 36.0,
          "default": null
        },
        "zero_elevation_rad": {
          "description": "No FC constraint exists for this field in the app today.",
          "type": "number", "default": 0.0
        },
        "vendor": { "type": "string", "default": "" },
        "notes": { "type": "string", "default": "" },
        "image": { "type": "string", "default": "" }
      }
    },

    "Sight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "focal_plane_value", "sight_height_inch",
        "sight_horizontal_offset_inch", "vertical_click", "horizontal_click",
        "vertical_click_unit", "horizontal_click_unit", "min_magnification",
        "max_magnification", "reticle_image", "calibrated_magnification",
        "vendor", "notes", "image"
      ],
      "properties": {
        "name": { "type": "string", "default": "" },
        "focal_plane_value": {
          "type": "string", "enum": ["ffp", "sfp", "lwir"], "default": "ffp"
        },
        "sight_height_inch": {
          "description": "FC.sightHeight, mm→inch (0–200mm).",
          "type": "number", "minimum": 0, "maximum": 7.874015748031496, "default": 0.0
        },
        "sight_horizontal_offset_inch": {
          "description": "Reuses FC.sightHeight, mm→inch (0–200mm) — same constraint the wizard applies to this field.",
          "type": "number", "minimum": 0, "maximum": 7.874015748031496, "default": 0.0
        },
        "vertical_click": {
          "description": "Self-describing value+unit pair with vertical_click_unit (stored in whatever unit that field names, see sight_wizard_notifier.dart) — no single fixed-unit bound applies.",
          "type": "number", "default": 0.1
        },
        "horizontal_click": {
          "description": "Self-describing value+unit pair with horizontal_click_unit — see vertical_click.",
          "type": "number", "default": 0.1
        },
        "vertical_click_unit": { "type": "string", "default": "mil" },
        "horizontal_click_unit": { "type": "string", "default": "mil" },
        "min_magnification": {
          "description": "FC.magnification, scalar (0.5–100).",
          "type": "number", "minimum": 0.5, "maximum": 100, "default": 1.0
        },
        "max_magnification": {
          "description": "FC.magnification, scalar (0.5–100).",
          "type": "number", "minimum": 0.5, "maximum": 100, "default": 1.0
        },
        "reticle_image": { "type": "string", "default": "" },
        "calibrated_magnification": {
          "description": "No dedicated FC constant; inferred from FC.magnification (0.5–100). optional in the .proto — null/absent means unset.",
          "type": ["number", "null"],
          "minimum": 0.5, "maximum": 100,
          "default": null
        },
        "vendor": { "type": "string", "default": "" },
        "notes": { "type": "string", "default": "" },
        "image": { "type": "string", "default": "" }
      }
    },

    "Zero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distance_meter", "look_angle_rad", "altitude_meter", "temperature_c",
        "pressure_h_pa", "humidity_frac", "use_diff_powder_temperature",
        "use_coriolis", "powder_temperature_c", "latitude_deg", "azimuth_deg",
        "offset_x", "offset_y", "offset_x_unit", "offset_y_unit"
      ],
      "properties": {
        "distance_meter": {
          "description": "FC.zeroDistance, meter (10–1000).",
          "type": "number", "minimum": 10, "maximum": 1000, "default": 100.0
        },
        "look_angle_rad": {
          "description": "FC.lookAngle, degree→radian (-90°..90°).",
          "type": "number", "minimum": -1.5707963267948966, "maximum": 1.5707963267948966, "default": 0.0
        },
        "altitude_meter": {
          "description": "FC.altitude, meter (-500–15000).",
          "type": "number", "minimum": -500, "maximum": 15000, "default": 0.0
        },
        "temperature_c": {
          "description": "FC.temperature, celsius (-100–100).",
          "type": "number", "minimum": -100, "maximum": 100, "default": 15.0
        },
        "pressure_h_pa": {
          "description": "FC.pressure, hPa (300–1500).",
          "type": "number", "minimum": 300, "maximum": 1500, "default": 1013.0
        },
        "humidity_frac": {
          "description": "FC.humidity, fraction (0–1).",
          "type": "number", "minimum": 0, "maximum": 1, "default": 0.0
        },
        "use_diff_powder_temperature": { "type": "boolean", "default": false },
        "use_coriolis": { "type": "boolean", "default": false },
        "powder_temperature_c": {
          "description": "FC.temperature, celsius (-100–100).",
          "type": "number", "minimum": -100, "maximum": 100, "default": 15.0
        },
        "latitude_deg": {
          "description": "FC.latitude, degree (-90–90).",
          "type": "number", "minimum": -90, "maximum": 90, "default": 0.0
        },
        "azimuth_deg": {
          "description": "FC.azimuth, degree (0–360).",
          "type": "number", "minimum": 0, "maximum": 360, "default": 0.0
        },
        "offset_x": {
          "description": "Self-describing value+unit pair with offset_x_unit — no single fixed-unit bound applies (see Sight.vertical_click).",
          "type": "number", "default": 0.0
        },
        "offset_y": {
          "description": "Self-describing value+unit pair with offset_y_unit.",
          "type": "number", "default": 0.0
        },
        "offset_x_unit": { "type": "string", "default": "mil" },
        "offset_y_unit": { "type": "string", "default": "mil" }
      }
    },

    "Ammo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "caliber_inch", "weight_grain", "length_inch",
        "drag_type_value", "bc_g1", "bc_g7", "use_multi_bc_g1",
        "use_multi_bc_g7", "muzzle_velocity_mps",
        "muzzle_velocity_temperature_c", "use_powder_sensitivity",
        "powder_sensitivity_frac", "powder_sensitivity_tc",
        "powder_sensitivity_v_mps", "multi_bc_table_g1_v_mps",
        "multi_bc_table_g1_bc", "multi_bc_table_g7_v_mps",
        "multi_bc_table_g7_bc", "custom_drag_table_mach",
        "custom_drag_table_cd", "zero", "projectile_name", "vendor", "image"
      ],
      "properties": {
        "name": { "type": "string", "default": "" },
        "caliber_inch": {
          "description": "FC.projectileDiameter, mm→inch (1–30mm). optional in the .proto — null/absent means unset.",
          "type": ["number", "null"],
          "minimum": 0.03937007874015748, "maximum": 1.1811023622047244,
          "default": null
        },
        "weight_grain": {
          "description": "FC.projectileWeight, grain (1–800). optional in the .proto — null/absent means unset.",
          "type": ["number", "null"],
          "minimum": 1, "maximum": 800,
          "default": null
        },
        "length_inch": {
          "description": "FC.projectileLength, mm→inch (1–100mm). optional in the .proto — null/absent means unset.",
          "type": ["number", "null"],
          "minimum": 0.03937007874015748, "maximum": 3.937007874015748,
          "default": null
        },
        "drag_type_value": {
          "type": "string", "enum": ["g1", "g7", "custom"], "default": "g1"
        },
        "bc_g1": {
          "description": "FC.ballisticCoefficient, scalar (0.001–2.000). optional in the .proto — null/absent means unset.",
          "type": ["number", "null"],
          "minimum": 0.001, "maximum": 2.000,
          "default": null
        },
        "bc_g7": {
          "description": "FC.ballisticCoefficient, scalar (0.001–2.000). optional in the .proto — null/absent means unset.",
          "type": ["number", "null"],
          "minimum": 0.001, "maximum": 2.000,
          "default": null
        },
        "use_multi_bc_g1": { "type": "boolean", "default": false },
        "use_multi_bc_g7": { "type": "boolean", "default": false },
        "muzzle_velocity_mps": {
          "description": "FC.muzzleVelocity, mps (100–1800). optional in the .proto — null/absent means unset.",
          "type": ["number", "null"],
          "minimum": 100, "maximum": 1800,
          "default": null
        },
        "muzzle_velocity_temperature_c": {
          "description": "FC.temperature, celsius (-100–100).",
          "type": "number", "minimum": -100, "maximum": 100, "default": 15.0
        },
        "use_powder_sensitivity": { "type": "boolean", "default": false },
        "powder_sensitivity_frac": {
          "description": "FC.powderSensitivity, fraction (0–5).",
          "type": "number", "minimum": 0, "maximum": 5, "default": 0.0
        },
        "powder_sensitivity_tc": { "type": "array", "items": { "type": "number" }, "default": [] },
        "powder_sensitivity_v_mps": { "type": "array", "items": { "type": "number" }, "default": [] },
        "multi_bc_table_g1_v_mps": { "type": "array", "items": { "type": "number" }, "default": [] },
        "multi_bc_table_g1_bc": { "type": "array", "items": { "type": "number" }, "default": [] },
        "multi_bc_table_g7_v_mps": { "type": "array", "items": { "type": "number" }, "default": [] },
        "multi_bc_table_g7_bc": { "type": "array", "items": { "type": "number" }, "default": [] },
        "custom_drag_table_mach": { "type": "array", "items": { "type": "number" }, "default": [] },
        "custom_drag_table_cd": { "type": "array", "items": { "type": "number" }, "default": [] },
        "zero": { "$ref": "#/$defs/Zero" },
        "projectile_name": { "type": "string", "default": "" },
        "vendor": { "type": "string", "default": "" },
        "image": { "type": "string", "default": "" }
      }
    },

    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ui_key", "name", "weapon", "ammo", "sight"],
      "properties": {
        "ui_key": { "type": "string" },
        "name": { "type": "string", "default": "" },
        "weapon": { "$ref": "#/$defs/Weapon" },
        "ammo": { "$ref": "#/$defs/Ammo" },
        "sight": { "$ref": "#/$defs/Sight" }
      }
    },

    "GeneralSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language_code", "theme_mode", "adjustment_display_format_value",
        "home_show_mil", "home_show_mrad", "home_show_moa",
        "home_show_cm_per100m", "home_show_in_per100yd", "home_show_in_clicks",
        "home_chart_distance_step", "home_table_distance_step",
        "home_show_subsonic_transition"
      ],
      "properties": {
        "language_code": { "type": "string", "default": "en" },
        "theme_mode": {
          "type": "string", "enum": ["system", "light", "dark"], "default": "system"
        },
        "adjustment_display_format_value": {
          "type": "string", "enum": ["arrows", "signs", "letters"], "default": "arrows"
        },
        "home_show_mil": { "type": "boolean", "default": false },
        "home_show_mrad": { "type": "boolean", "default": false },
        "home_show_moa": { "type": "boolean", "default": false },
        "home_show_cm_per100m": { "type": "boolean", "default": false },
        "home_show_in_per100yd": { "type": "boolean", "default": false },
        "home_show_in_clicks": { "type": "boolean", "default": false },
        "home_chart_distance_step": {
          "description": "FC.distanceStep, meter (1–1000).",
          "type": "number", "minimum": 1, "maximum": 1000, "default": 10.0
        },
        "home_table_distance_step": {
          "description": "FC.distanceStep, meter (1–1000).",
          "type": "number", "minimum": 1, "maximum": 1000, "default": 10.0
        },
        "home_show_subsonic_transition": { "type": "boolean", "default": false }
      }
    },

    "TablesSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distance_start_meter", "distance_end_meter", "distance_step_meter",
        "show_zeros", "show_subsonic_transition", "hidden_cols", "show_mil",
        "show_mrad", "show_moa", "show_cm_per100m", "show_in_per100yd",
        "show_in_clicks"
      ],
      "properties": {
        "distance_start_meter": {
          "description": "FC.tableRange, meter (0–5000).",
          "type": "number", "minimum": 0, "maximum": 5000, "default": 0.0
        },
        "distance_end_meter": {
          "description": "FC.tableRange, meter (0–5000).",
          "type": "number", "minimum": 0, "maximum": 5000, "default": 2000.0
        },
        "distance_step_meter": {
          "description": "FC.distanceStep, meter (1–1000).",
          "type": "number", "minimum": 1, "maximum": 1000, "default": 100.0
        },
        "show_zeros": { "type": "boolean", "default": true },
        "show_subsonic_transition": { "type": "boolean", "default": true },
        "hidden_cols": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "range", "time", "velocity", "height", "drop", "adjDrop",
              "wind", "adjWind", "mach", "drag", "energy"
            ]
          },
          "default": []
        },
        "show_mil": { "type": "boolean", "default": false },
        "show_mrad": { "type": "boolean", "default": false },
        "show_moa": { "type": "boolean", "default": false },
        "show_cm_per100m": { "type": "boolean", "default": false },
        "show_in_per100yd": { "type": "boolean", "default": false },
        "show_in_clicks": { "type": "boolean", "default": false }
      }
    },

    "UnitSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "angular", "distance", "velocity", "pressure", "temperature",
        "diameter", "length", "weight", "adjustment", "drop", "energy",
        "sight_height", "twist", "barrel_length", "time", "torque",
        "target_size"
      ],
      "description": "Each field is a dart_bclibc Unit enum name — not enumerated here (external package, out of this schema's scope).",
      "properties": {
        "angular": { "type": "string", "default": "degree" },
        "distance": { "type": "string", "default": "meter" },
        "velocity": { "type": "string", "default": "mps" },
        "pressure": { "type": "string", "default": "hPa" },
        "temperature": { "type": "string", "default": "celsius" },
        "diameter": { "type": "string", "default": "inch" },
        "length": { "type": "string", "default": "inch" },
        "weight": { "type": "string", "default": "grain" },
        "adjustment": { "type": "string", "default": "mil" },
        "drop": { "type": "string", "default": "cm" },
        "energy": { "type": "string", "default": "joule" },
        "sight_height": { "type": "string", "default": "inch" },
        "twist": { "type": "string", "default": "inch" },
        "barrel_length": { "type": "string", "default": "inch" },
        "time": { "type": "string", "default": "second" },
        "torque": { "type": "string", "default": "newtonMeter" },
        "target_size": { "type": "string", "default": "mil" }
      }
    },

    "ShootingConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distance_meter", "look_angle_rad", "altitude_meter", "temperature_c",
        "pressure_h_pa", "humidity_frac", "powder_temperature_c",
        "use_powder_sensitivity", "use_diff_powder_temp", "use_coriolis",
        "latitude_deg", "azimuth_deg", "wind_direction_deg", "wind_speed_mps"
      ],
      "properties": {
        "distance_meter": {
          "description": "FC.targetDistance, meter (10–3000).",
          "type": "number", "minimum": 10, "maximum": 3000, "default": 100.0
        },
        "look_angle_rad": {
          "description": "FC.lookAngle, degree→radian (-90°..90°).",
          "type": "number", "minimum": -1.5707963267948966, "maximum": 1.5707963267948966, "default": 0.0
        },
        "altitude_meter": {
          "description": "FC.altitude, meter (-500–15000).",
          "type": "number", "minimum": -500, "maximum": 15000, "default": 0.0
        },
        "temperature_c": {
          "description": "FC.temperature, celsius (-100–100).",
          "type": "number", "minimum": -100, "maximum": 100, "default": 15.0
        },
        "pressure_h_pa": {
          "description": "FC.pressure, hPa (300–1500).",
          "type": "number", "minimum": 300, "maximum": 1500, "default": 1013.25
        },
        "humidity_frac": {
          "description": "FC.humidity, fraction (0–1).",
          "type": "number", "minimum": 0, "maximum": 1, "default": 0.0
        },
        "powder_temperature_c": {
          "description": "FC.temperature, celsius (-100–100).",
          "type": "number", "minimum": -100, "maximum": 100, "default": 15.0
        },
        "use_powder_sensitivity": { "type": "boolean", "default": false },
        "use_diff_powder_temp": { "type": "boolean", "default": false },
        "use_coriolis": { "type": "boolean", "default": false },
        "latitude_deg": {
          "description": "FC.latitude, degree (-90–90).",
          "type": "number", "minimum": -90, "maximum": 90, "default": 0.0
        },
        "azimuth_deg": {
          "description": "FC.azimuth, degree (0–360).",
          "type": "number", "minimum": 0, "maximum": 360, "default": 0.0
        },
        "wind_direction_deg": {
          "description": "FC.windDirection, degree (0–360).",
          "type": "number", "minimum": 0, "maximum": 360, "default": 0.0
        },
        "wind_speed_mps": {
          "description": "FC.windSpeed, mps (0–30).",
          "type": "number", "minimum": 0, "maximum": 30, "default": 0.0
        }
      }
    },

    "UnitValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "last_unit"],
      "properties": {
        "value": { "type": "number" },
        "last_unit": { "type": "string" }
      }
    },

    "AnglesConv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distance_value_meter", "distance_last_unit", "angular_value_mil",
        "angular_last_unit", "output_last_unit"
      ],
      "properties": {
        "distance_value_meter": {
          "description": "FC.convertorDistance, meter (0–5000).",
          "type": "number", "minimum": 0, "maximum": 5000, "default": 100.0
        },
        "distance_last_unit": { "type": "string", "default": "meter" },
        "angular_value_mil": {
          "description": "Only a '>= 0' floor is actually enforced in code (angular_convertor_vm.dart); no confirmed upper bound to port.",
          "type": "number", "minimum": 0, "default": 1.0
        },
        "angular_last_unit": { "type": "string", "default": "mil" },
        "output_last_unit": { "type": "string", "default": "centimeter" }
      }
    },

    "VelocityConv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_mps", "last_unit", "mach_input_value", "mach_use_custom_atmo",
        "atmo_temperature_c", "atmo_pressure_h_pa", "atmo_humidity_frac",
        "atmo_altitude_meter"
      ],
      "properties": {
        "value_mps": {
          "description": "FC.convertorVelocity, mps (0–3000).",
          "type": "number", "minimum": 0, "maximum": 3000, "default": 300.0
        },
        "last_unit": { "type": "string", "default": "mps" },
        "mach_input_value": { "type": "number", "default": 0.881 },
        "mach_use_custom_atmo": { "type": "boolean", "default": false },
        "atmo_temperature_c": {
          "description": "FC.temperature, celsius (-100–100).",
          "type": "number", "minimum": -100, "maximum": 100, "default": 15.0
        },
        "atmo_pressure_h_pa": {
          "description": "FC.pressure, hPa (300–1500).",
          "type": "number", "minimum": 300, "maximum": 1500, "default": 1013.25
        },
        "atmo_humidity_frac": {
          "description": "FC.humidity, fraction (0–1).",
          "type": "number", "minimum": 0, "maximum": 1, "default": 0.0
        },
        "atmo_altitude_meter": {
          "description": "FC.altitude, meter (-500–15000).",
          "type": "number", "minimum": -500, "maximum": 15000, "default": 0.0
        }
      }
    },

    "DistanceConvTargetSize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_inch", "size_unit", "size_angular_mil", "size_angular_unit"
      ],
      "properties": {
        "size_inch": {
          "description": "FC.convertorTargetPhysicalSize, inch (0–9999).",
          "type": "number", "minimum": 0, "maximum": 9999, "default": 8.0
        },
        "size_unit": { "type": "string", "default": "inch" },
        "size_angular_mil": {
          "description": "FC.targetSize, mil (0.001–100).",
          "type": "number", "minimum": 0.001, "maximum": 100, "default": 1.0
        },
        "size_angular_unit": { "type": "string", "default": "mil" }
      }
    },

    "ConvertorsState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length", "weight", "pressure", "temperature", "torque", "angles",
        "velocity", "distance_conv_target_size"
      ],
      "properties": {
        "length": {
          "description": "FC.convertorLength, inch (0–9999).",
          "allOf": [{ "$ref": "#/$defs/UnitValue" }],
          "properties": { "value": { "minimum": 0, "maximum": 9999 } },
          "default": { "value": 100.0, "last_unit": "inch" }
        },
        "weight": {
          "description": "FC.convertorWeight, grain (0–9999).",
          "allOf": [{ "$ref": "#/$defs/UnitValue" }],
          "properties": { "value": { "minimum": 0, "maximum": 9999 } },
          "default": { "value": 100.0, "last_unit": "grain" }
        },
        "pressure": {
          "description": "Stored in mmHg despite FC.convertorPressure declaring rawUnit hPa — pressure_convertor_vm.dart applies these numbers (300–1500) directly as mmHg. Porting actual app behavior, not the constant's label.",
          "allOf": [{ "$ref": "#/$defs/UnitValue" }],
          "properties": { "value": { "minimum": 300, "maximum": 1500 } },
          "default": { "value": 1013.0, "last_unit": "hPa" }
        },
        "temperature": {
          "description": "temperature_convertor_vm.dart hardcodes its own range (absolute zero to 10000°F), not FC.",
          "allOf": [{ "$ref": "#/$defs/UnitValue" }],
          "properties": { "value": { "minimum": -459.67, "maximum": 10000.0 } },
          "default": { "value": 68.0, "last_unit": "celsius" }
        },
        "torque": {
          "description": "x-discrepancy: FC.convertorTorque (== FC.torque) declares [300,1500] newtonMeter, but ConvertorsState.torqueValueNewtonMeter's own app default (100.0) falls outside that range — left unbounded pending a decision on which side is wrong.",
          "allOf": [{ "$ref": "#/$defs/UnitValue" }],
          "default": { "value": 100.0, "last_unit": "newtonMeter" }
        },
        "angles": { "$ref": "#/$defs/AnglesConv" },
        "velocity": { "$ref": "#/$defs/VelocityConv" },
        "distance_conv_target_size": { "$ref": "#/$defs/DistanceConvTargetSize" }
      }
    },

    "ReticleSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertical_adjustment", "vertical_adjustment_unit",
        "horizontal_adjustment", "horizontal_adjustment_unit", "target_image"
      ],
      "properties": {
        "vertical_adjustment": {
          "description": "Self-describing value+unit pair with vertical_adjustment_unit (same pattern as Sight.vertical_click) — no single fixed-unit bound applies.",
          "type": "number", "default": 0.0
        },
        "vertical_adjustment_unit": { "type": "string", "default": "mil" },
        "horizontal_adjustment": {
          "description": "Self-describing value+unit pair with horizontal_adjustment_unit.",
          "type": "number", "default": 0.0
        },
        "horizontal_adjustment_unit": { "type": "string", "default": "mil" },
        "target_image": { "type": "string", "default": "" }
      }
    },

    "Db": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "general_settings", "unit_settings",
        "tables_settings", "reticle_settings", "convertors_state",
        "shooting_conditions", "profiles"
      ],
      "properties": {
        "schema_version": { "type": "integer", "minimum": 0 },
        "general_settings": { "$ref": "#/$defs/GeneralSettings" },
        "unit_settings": { "$ref": "#/$defs/UnitSettings" },
        "tables_settings": { "$ref": "#/$defs/TablesSettings" },
        "reticle_settings": { "$ref": "#/$defs/ReticleSettings" },
        "convertors_state": { "$ref": "#/$defs/ConvertorsState" },
        "shooting_conditions": { "$ref": "#/$defs/ShootingConditions" },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/Profile" },
          "description": "profiles[0] is the active profile."
        }
      }
    }
  }
}
